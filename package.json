    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@react-email/components": "0.0.41",
    "aws-lambda": "^1.0.7",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
